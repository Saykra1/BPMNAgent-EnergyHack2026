    <bpmn:sequenceFlow id="Flow_6" sourceRef="SendTask_1" targetRef="EndEvent_2"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_1" targetRef="Gateway_2" name="Аварийное">
