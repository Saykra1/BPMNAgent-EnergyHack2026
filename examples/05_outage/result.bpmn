<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Agent" exporterVersion="1.0" name="Устранение аварийного отключения электроэнергии">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Электросетевая компания" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false" name="Электросетевая компания">
    <bpmn:laneSet id="LaneSet_Process_1">
      <bpmn:lane id="sub" name="Абонент">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="disp" name="Диспетчер">
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>telemetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_planned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dgu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sys" name="Информационная система">
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sms_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="crew" name="Аварийная бригада">
        <bpmn:flowNodeRef>go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>localize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>restore</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end" name="Конец">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="report" name="Сообщить об отключении">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="register" name="Зарегистрировать обращение">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="telemetry" name="Проверить данные телемеханики">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_type" name="Тип отключения?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="inform" name="Сообщить сроки восстановления">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_planned" name="Обращение закрыто">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="p1">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="order" name="Сформировать наряд">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="sms" name="Отправить SMS абонентам участка">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="go" name="Выехать на место аварии">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="localize" name="Локализовать повреждение">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="repair" name="Устранить повреждение">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_time" name="Устранено за 4 часа?" default="Flow_15">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="dgu" name="Подключить резервный источник питания">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="restore" name="Восстановить схему электроснабжения">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="p1_join">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="check_v" name="Проверить подачу напряжения">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="close" name="Закрыть наряд">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="sms_ok" name="Уведомить о восстановлении">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="report"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="report" targetRef="register"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="register" targetRef="telemetry"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="telemetry" targetRef="gw_type"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="gw_type" targetRef="inform" name="Плановое">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Плановое</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="inform" targetRef="end_planned"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="gw_type" targetRef="p1" name="Аварийное">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Аварийное</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="p1" targetRef="order"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="p1" targetRef="sms"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="order" targetRef="go"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="go" targetRef="localize"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="localize" targetRef="repair"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="repair" targetRef="gw_time"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="gw_time" targetRef="restore" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="gw_time" targetRef="dgu" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="dgu" targetRef="repair"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="restore" targetRef="p1_join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="sms" targetRef="p1_join"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="p1_join" targetRef="check_v"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="check_v" targetRef="close"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="close" targetRef="sms_ok"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="sms_ok" targetRef="end"/>
  </bpmn:process>
