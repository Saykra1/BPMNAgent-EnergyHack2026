<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Agent" exporterVersion="1.0" name="Технологическое присоединение к электрическим сетям">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Сетевая организация" processRef="Process_1"/>
    <bpmn:participant id="contractor" name="Подрядная организация"/>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="build" targetRef="contractor" name="Заказ на строительство"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false" name="Сетевая организация">
    <bpmn:laneSet id="LaneSet_Process_1">
      <bpmn:lane id="applicant" name="Заявитель">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>add_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>own_side</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="clients" name="Отдел по работе с клиентами">
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>act</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="tech" name="Технический отдел">
        <bpmn:flowNodeRef>build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check_power</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_power</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>plan_upgrade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_power_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_remarks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="chief" name="Главный инженер">
        <bpmn:flowNodeRef>approve_upgrade</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ops" name="Оперативный персонал">
        <bpmn:flowNodeRef>connect</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end" name="Конец">
      <bpmn:incoming>Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="build" name="Построить сетевые объекты">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "подрядная организация строит сетевые объекты", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:task id="b1" name="Выполнить проектирование">
        <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "", "assumption": "Детализация строительства из эталонного плана; в исходном описании этот шаг отдельно не указан.", "deadline": "", "documents": []}</bpmn:documentation>
        <bpmn:incoming>Flow_34</bpmn:incoming>
        <bpmn:outgoing>Flow_32</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="b2" name="Выполнить строительно-монтажные работы">
        <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "", "assumption": "Детализация строительства из эталонного плана; в исходном описании этот шаг отдельно не указан.", "deadline": "", "documents": []}</bpmn:documentation>
        <bpmn:incoming>Flow_32</bpmn:incoming>
        <bpmn:outgoing>Flow_33</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="b3" name="Сдать объекты сетевой организации">
        <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "", "assumption": "Детализация строительства из эталонного плана; в исходном описании этот шаг отдельно не указан.", "deadline": "", "documents": []}</bpmn:documentation>
        <bpmn:incoming>Flow_33</bpmn:incoming>
        <bpmn:outgoing>Flow_35</bpmn:outgoing>
      </bpmn:task>
      <bpmn:startEvent id="StartEvent_1">
        <bpmn:outgoing>Flow_34</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="EndEvent_1">
        <bpmn:incoming>Flow_35</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_32" sourceRef="b1" targetRef="b2"/>
      <bpmn:sequenceFlow id="Flow_33" sourceRef="b2" targetRef="b3"/>
      <bpmn:sequenceFlow id="Flow_34" sourceRef="StartEvent_1" targetRef="b1"/>
      <bpmn:sequenceFlow id="Flow_35" sourceRef="b3" targetRef="EndEvent_1"/>
    </bpmn:subProcess>
    <bpmn:userTask id="apply" name="Подать заявку на присоединение">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Заявитель подаёт заявку на технологическое присоединение через личный кабинет сетевой организации.", "assumption": "", "deadline": "", "documents": ["Заявка на технологическое присоединение"]}</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="check_docs" name="Проверить комплектность документов">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Специалист отдела по работе с клиентами проверяет комплектность документов.", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_docs" name="Документы в порядке?" default="Flow_5">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Если документов не хватает", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="notify_docs" name="Уведомить о недостающих документах">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "заявителю направляется уведомление", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="add_docs" name="Дополнить документы">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Если документов не хватает, заявителю направляется уведомление, и у него есть 20 рабочих дней на их предоставление; заявитель дополняет документы, и проверка повторяется.", "assumption": "В описании не определены точка отсчёта срока и исход при просрочке.", "deadline": "20 рабочих дней; точку отсчёта необходимо уточнить", "documents": ["Недостающие документы"]}</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="check_power" name="Проверить свободную мощность">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "технический отдел проверяет наличие свободной мощности на центре питания", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_power" name="Мощности достаточно?" default="Flow_10">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Если мощности недостаточно", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="plan_upgrade" name="Разработать мероприятие по увеличению мощности">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "разрабатывается мероприятие по увеличению мощности", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="approve_upgrade" name="Согласовать мероприятие">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "которое согласует главный инженер", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_power_join">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="p1">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="tu" name="Подготовить технические условия">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Затем технический отдел готовит технические условия", "assumption": "", "deadline": "", "documents": ["Технические условия"]}</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="fee" name="Рассчитать плату за присоединение">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "отдел по работе с клиентами параллельно рассчитывает плату за присоединение", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="p1_join">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="send_contract" name="Направить договор и ТУ">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "После этого заявителю направляется договор с техническими условиями.", "assumption": "", "deadline": "", "documents": ["Договор", "Технические условия"]}</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="sign_pay" name="Подписать договор и оплатить">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Заявитель подписывает договор и оплачивает услугу.", "assumption": "", "deadline": "", "documents": ["Договор"]}</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="p2">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="own_side" name="Выполнить мероприятия на своей стороне">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "заявитель выполняет мероприятия на своей стороне", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="p2_join">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="inspect" name="Провести осмотр электроустановки">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "После этого инспектор проводит осмотр электроустановки.", "assumption": "Инспектор отнесён к техническому отделу — организационную принадлежность нужно подтвердить.", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_remarks" name="Есть замечания?" default="Flow_29">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Если выявлены замечания", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="fix" name="Устранить замечания">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "заявитель их устраняет и осмотр повторяется", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="connect" name="Подать напряжение">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "оперативный персонал выполняет фактическое присоединение и подача напряжения", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="act" name="Оформить и направить акт о присоединении">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "отдел по работе с клиентами оформляет акт об осуществлении технологического присоединения и направляет его заявителю", "assumption": "", "deadline": "", "documents": ["Акт об осуществлении технологического присоединения"]}</bpmn:documentation>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="apply"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="apply" targetRef="check_docs"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="check_docs" targetRef="gw_docs"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="gw_docs" targetRef="check_power" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="gw_docs" targetRef="notify_docs" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="notify_docs" targetRef="add_docs"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="add_docs" targetRef="check_docs"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="check_power" targetRef="gw_power"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="gw_power" targetRef="gw_power_join" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="gw_power" targetRef="plan_upgrade" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="plan_upgrade" targetRef="approve_upgrade"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="approve_upgrade" targetRef="gw_power_join"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="gw_power_join" targetRef="p1"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="p1" targetRef="tu"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="p1" targetRef="fee"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="tu" targetRef="p1_join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="fee" targetRef="p1_join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="p1_join" targetRef="send_contract"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="send_contract" targetRef="sign_pay"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="sign_pay" targetRef="p2"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="p2" targetRef="build"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="p2" targetRef="own_side"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="build" targetRef="p2_join"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="own_side" targetRef="p2_join"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="p2_join" targetRef="inspect"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="inspect" targetRef="gw_remarks"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="gw_remarks" targetRef="fix" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="fix" targetRef="inspect"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="gw_remarks" targetRef="connect" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="connect" targetRef="act"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="act" targetRef="end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="3572" height="850"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="contractor_di" bpmnElement="contractor" isHorizontal="true">
        <dc:Bounds x="60" y="960" width="3572" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="applicant_di" bpmnElement="applicant" isHorizontal="true">
        <dc:Bounds x="90" y="60" width="3542" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="clients_di" bpmnElement="clients" isHorizontal="true">
        <dc:Bounds x="90" y="204" width="3542" height="154"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tech_di" bpmnElement="tech" isHorizontal="true">
        <dc:Bounds x="90" y="358" width="3542" height="264"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="chief_di" bpmnElement="chief" isHorizontal="true">
        <dc:Bounds x="90" y="622" width="3542" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ops_di" bpmnElement="ops" isHorizontal="true">
        <dc:Bounds x="90" y="766" width="3542" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="150" y="117" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="120" y="159" width="96" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="3566" y="261" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3536" y="303" width="96" height="14"/>
