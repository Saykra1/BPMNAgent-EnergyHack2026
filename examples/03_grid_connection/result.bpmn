<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Сетевая организация" processRef="Process_1"/>
    <bpmn:participant id="Participant_2" name="Подрядная организация"/>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="SubProcess_1" targetRef="Participant_2" name="Заказ на строительство"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false" name="Сетевая организация">
    <bpmn:laneSet id="LaneSet_Process_1">
      <bpmn:lane id="Lane_1" name="Заявитель">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ManualTask_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ManualTask_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Отдел по работе с клиентами">
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Технический отдел">
        <bpmn:flowNodeRef>SubProcess_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ManualTask_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Главный инженер">
        <bpmn:flowNodeRef>UserTask_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Оперативный персонал">
        <bpmn:flowNodeRef>ManualTask_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_1" name="Конец">
      <bpmn:incoming>Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_1" name="Построить сетевые объекты">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "подрядная организация строит сетевые объекты", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:task id="Task_4" name="Выполнить проектирование">
        <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "", "assumption": "Детализация строительства из эталонного плана; в исходном описании этот шаг отдельно не указан.", "deadline": "", "documents": []}</bpmn:documentation>
        <bpmn:incoming>Flow_34</bpmn:incoming>
        <bpmn:outgoing>Flow_32</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_5" name="Выполнить строительно-монтажные работы">
        <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "", "assumption": "Детализация строительства из эталонного плана; в исходном описании этот шаг отдельно не указан.", "deadline": "", "documents": []}</bpmn:documentation>
        <bpmn:incoming>Flow_32</bpmn:incoming>
        <bpmn:outgoing>Flow_33</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_6" name="Сдать объекты сетевой организации">
        <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "", "assumption": "Детализация строительства из эталонного плана; в исходном описании этот шаг отдельно не указан.", "deadline": "", "documents": []}</bpmn:documentation>
        <bpmn:incoming>Flow_33</bpmn:incoming>
        <bpmn:outgoing>Flow_35</bpmn:outgoing>
      </bpmn:task>
      <bpmn:startEvent id="StartEvent_2">
        <bpmn:outgoing>Flow_34</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="EndEvent_2">
        <bpmn:incoming>Flow_35</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_4" targetRef="Task_5"/>
      <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_5" targetRef="Task_6"/>
      <bpmn:sequenceFlow id="Flow_34" sourceRef="StartEvent_2" targetRef="Task_4"/>
      <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_6" targetRef="EndEvent_2"/>
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask_1" name="Подать заявку на присоединение">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Заявитель подаёт заявку на технологическое присоединение через личный кабинет сетевой организации.", "assumption": "", "deadline": "", "documents": ["Заявка на технологическое присоединение"]}</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_2" name="Проверить комплектность документов">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Специалист отдела по работе с клиентами проверяет комплектность документов.", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="Документы в порядке?">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Если документов не хватает", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask_1" name="Уведомить о недостающих документах">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "заявителю направляется уведомление", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask_3" name="Дополнить документы">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Если документов не хватает, заявителю направляется уведомление, и у него есть 20 рабочих дней на их предоставление; заявитель дополняет документы, и проверка повторяется.", "assumption": "В описании не определены точка отсчёта срока и исход при просрочке.", "deadline": "20 рабочих дней; точку отсчёта необходимо уточнить", "documents": ["Недостающие документы"]}</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_1" name="Проверить свободную мощность">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "технический отдел проверяет наличие свободной мощности на центре питания", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_2" name="Мощности достаточно?">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Если мощности недостаточно", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_2" name="Разработать мероприятие по увеличению мощности">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "разрабатывается мероприятие по увеличению мощности", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="UserTask_4" name="Согласовать мероприятие">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "которое согласует главный инженер", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_3">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_4">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_3" name="Подготовить технические условия">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Затем технический отдел готовит технические условия", "assumption": "", "deadline": "", "documents": ["Технические условия"]}</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="ServiceTask_1" name="Рассчитать плату за присоединение">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "отдел по работе с клиентами параллельно рассчитывает плату за присоединение", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_5">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="SendTask_2" name="Направить договор и ТУ">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "После этого заявителю направляется договор с техническими условиями.", "assumption": "", "deadline": "", "documents": ["Договор", "Технические условия"]}</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="UserTask_5" name="Подписать договор и оплатить">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Заявитель подписывает договор и оплачивает услугу.", "assumption": "", "deadline": "", "documents": ["Договор"]}</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_6">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="ManualTask_1" name="Выполнить мероприятия на своей стороне">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "заявитель выполняет мероприятия на своей стороне", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="Gateway_7">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="ManualTask_2" name="Провести осмотр электроустановки">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "После этого инспектор проводит осмотр электроустановки.", "assumption": "Инспектор отнесён к техническому отделу — организационную принадлежность нужно подтвердить.", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_8" name="Есть замечания?">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "Если выявлены замечания", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="ManualTask_3" name="Устранить замечания">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "заявитель их устраняет и осмотр повторяется", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="ManualTask_4" name="Подать напряжение">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "оперативный персонал выполняет фактическое присоединение и подача напряжения", "assumption": "", "deadline": "", "documents": []}</bpmn:documentation>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="SendTask_3" name="Оформить и направить акт о присоединении">
      <bpmn:documentation textFormat="application/json">BPMN_AGENT_DETAILS:{"source_quote": "отдел по работе с клиентами оформляет акт об осуществлении технологического присоединения и направляет его заявителю", "assumption": "", "deadline": "", "documents": ["Акт об осуществлении технологического присоединения"]}</bpmn:documentation>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_1" targetRef="UserTask_2"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="UserTask_2" targetRef="Gateway_1"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_1" targetRef="Task_1" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_1" targetRef="SendTask_1" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="SendTask_1" targetRef="UserTask_3"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="UserTask_3" targetRef="UserTask_2"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_1" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_2" targetRef="Gateway_3" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_2" targetRef="Task_2" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_2" targetRef="UserTask_4"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="UserTask_4" targetRef="Gateway_3"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_3" targetRef="Gateway_4"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_4" targetRef="Task_3"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_4" targetRef="ServiceTask_1"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_3" targetRef="Gateway_5"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="ServiceTask_1" targetRef="Gateway_5"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_5" targetRef="SendTask_2"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="SendTask_2" targetRef="UserTask_5"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="UserTask_5" targetRef="Gateway_6"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_6" targetRef="SubProcess_1"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_6" targetRef="ManualTask_1"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="SubProcess_1" targetRef="Gateway_7"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="ManualTask_1" targetRef="Gateway_7"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_7" targetRef="ManualTask_2"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="ManualTask_2" targetRef="Gateway_8"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_8" targetRef="ManualTask_3" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="ManualTask_3" targetRef="ManualTask_2"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_8" targetRef="ManualTask_4" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="ManualTask_4" targetRef="SendTask_3"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="SendTask_3" targetRef="EndEvent_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="3572" height="850"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_2_di" bpmnElement="Participant_2" isHorizontal="true">
        <dc:Bounds x="60" y="960" width="3572" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="90" y="60" width="3542" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="90" y="204" width="3542" height="154"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true">
        <dc:Bounds x="90" y="358" width="3542" height="264"/>
      </bpmndi:BPMNShape>
