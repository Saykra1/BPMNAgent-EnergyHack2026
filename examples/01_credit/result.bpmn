<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Agent" exporterVersion="1.0" name="Выдача потребительского кредита">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Банк" processRef="Process_1"/>
    <bpmn:participant id="bki" name="Бюро кредитных историй"/>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="history" targetRef="bki" name="Запрос кредитной истории"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false" name="Банк">
    <bpmn:laneSet id="LaneSet_Process_1">
      <bpmn:lane id="client" name="Клиент">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="Банковская система">
        <bpmn:flowNodeRef>check_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_full</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req_more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>history</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="sec" name="Служба безопасности">
        <bpmn:flowNodeRef>blacklist</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="manager" name="Кредитный менеджер">
        <bpmn:flowNodeRef>par_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>manager_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_dec_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>contract</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="committee" name="Кредитный комитет">
        <bpmn:flowNodeRef>committee_decide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="acc" name="Бухгалтерия">
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>transfer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end" name="Конец">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="submit" name="Подать заявку на кредит">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="check_form" name="Проверить полноту анкеты">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_full" name="Анкета заполнена?" default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="req_more" name="Запросить недостающие данные">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="fill" name="Дополнить анкету">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="par_split">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="blacklist" name="Проверить по чёрным спискам">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="history" name="Запросить кредитную историю">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="par_join">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="assess" name="Оценить платёжеспособность">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_sum" name="Сумма больше 1 млн?" default="Flow_15">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="committee_decide" name="Принять решение комитетом">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="manager_decide" name="Принять решение по кредиту">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_dec_join">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_approved" name="Кредит одобрен?" default="Flow_20">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="notify_reject" name="Уведомить об отказе">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_reject" name="Кредит не выдан">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="contract" name="Подготовить договор">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="sign" name="Подписать договор">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="transfer" name="Перечислить деньги на счёт">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="submit"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="submit" targetRef="check_form"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="check_form" targetRef="gw_full"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="gw_full" targetRef="par_split" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="gw_full" targetRef="req_more" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="req_more" targetRef="fill"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="fill" targetRef="check_form"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="par_split" targetRef="blacklist"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="par_split" targetRef="history"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="blacklist" targetRef="par_join"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="history" targetRef="par_join"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="par_join" targetRef="assess"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="assess" targetRef="gw_sum"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="gw_sum" targetRef="committee_decide" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="gw_sum" targetRef="manager_decide" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="committee_decide" targetRef="gw_dec_join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="manager_decide" targetRef="gw_dec_join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="gw_dec_join" targetRef="gw_approved"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="gw_approved" targetRef="contract" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="gw_approved" targetRef="notify_reject" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="notify_reject" targetRef="end_reject"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="contract" targetRef="sign"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="sign" targetRef="transfer"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="transfer" targetRef="end"/>
  </bpmn:process>
