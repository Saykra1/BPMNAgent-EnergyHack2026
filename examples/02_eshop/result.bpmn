<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Интернет-магазин" processRef="Process_1"/>
    <bpmn:participant id="Participant_2" name="Платёжный шлюз банка"/>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="pay" targetRef="Participant_2" name="Платёж"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Participant_2" targetRef="confirm" name="Подтверждение оплаты"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false" name="Интернет-магазин">
    <bpmn:laneSet id="LaneSet_Process_1">
      <bpmn:lane id="Lane_1" name="Покупатель">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_accept</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Менеджер">
        <bpmn:flowNodeRef>gw_pay_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Склад">
        <bpmn:flowNodeRef>pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>process_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Бухгалтерия">
        <bpmn:flowNodeRef>docs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Служба доставки">
        <bpmn:flowNodeRef>p_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>return_goods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end" name="Конец">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="order" name="Оформить заказ">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_pay" name="Способ оплаты?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="pay" name="Оплатить заказ онлайн">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_pay_join">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="confirm" name="Подтвердить заказ">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="p_split">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="pick" name="Собрать заказ">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="docs" name="Сформировать чек и документы">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="p_join">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="deliver" name="Доставить заказ">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="receive" name="Получить заказ">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_accept" name="Покупатель принял заказ?" default="Flow_16">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="return_goods" name="Вернуть товар на склад">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="process_return" name="Оформить возврат">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_return" name="Заказ возвращён">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="order"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="order" targetRef="gw_pay"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="gw_pay" targetRef="pay" name="Картой онлайн">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Картой онлайн</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="gw_pay" targetRef="gw_pay_join" name="При получении">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">При получении</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="pay" targetRef="gw_pay_join"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="gw_pay_join" targetRef="confirm"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="confirm" targetRef="p_split"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="p_split" targetRef="pick"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="p_split" targetRef="docs"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="pick" targetRef="p_join"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="docs" targetRef="p_join"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="p_join" targetRef="deliver"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="deliver" targetRef="receive"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="receive" targetRef="gw_accept"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="gw_accept" targetRef="end" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="gw_accept" targetRef="return_goods" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="return_goods" targetRef="process_return"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="process_return" targetRef="end_return"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="2382" height="830"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_2_di" bpmnElement="Participant_2" isHorizontal="true">
