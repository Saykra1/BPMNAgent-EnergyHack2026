<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Компания" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false" name="Компания">
    <bpmn:laneSet id="LaneSet_Process_1">
      <bpmn:lane id="Lane_1" name="Руководитель подразделения">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_checks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="HR-менеджер">
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_fit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_checks_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hire</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Кандидат">
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Служба безопасности">
        <bpmn:flowNodeRef>sb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Директор">
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end" name="Конец">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="request" name="Создать заявку на подбор">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="publish" name="Опубликовать вакансию">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="screen" name="Отобрать резюме">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="interview" name="Провести первичное интервью">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_fit" name="Кандидат подходит?" default="Flow_7">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="reject" name="Отправить отказ кандидату">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="test" name="Выполнить тестовое задание">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="tech" name="Провести техническое интервью">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="decide" name="Принять решение по кандидату">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="gw_checks" name="Нужные проверки?" default="Flow_14">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="sb" name="Проверить кандидата">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="approve" name="Согласовать кандидата">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="gw_checks_join">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sendTask id="offer" name="Направить оффер">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="gw_offer" name="Оффер принят?" default="Flow_20">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="hire" name="Оформить на работу">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_no" name="Кандидат отказался">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="request"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="request" targetRef="publish"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="publish" targetRef="screen"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="screen" targetRef="interview"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="interview" targetRef="gw_fit"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="gw_fit" targetRef="test" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="gw_fit" targetRef="reject" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="reject" targetRef="screen"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="test" targetRef="tech"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="tech" targetRef="decide"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="decide" targetRef="gw_checks"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="gw_checks" targetRef="sb" name="Нужна проверка СБ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нужна проверка СБ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="gw_checks" targetRef="approve" name="Нужно согласование">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нужно согласование</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="gw_checks" targetRef="gw_checks_join" name="Проверки не нужны"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="sb" targetRef="gw_checks_join"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="approve" targetRef="gw_checks_join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="gw_checks_join" targetRef="offer"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="offer" targetRef="gw_offer"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="gw_offer" targetRef="hire" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="gw_offer" targetRef="end_no" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="hire" targetRef="end"/>
  </bpmn:process>
