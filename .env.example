# Провайдер LLM: anthropic | gemini | openai (любой OpenAI-совместимый API: OpenAI, vLLM, Ollama, LM Studio,
# OpenRouter, шлюзы к GigaChat / YandexGPT)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Модель: для anthropic по умолчанию claude-opus-5-5, для gemini — gemini-2.5-flash; для openai укажите явно (например qwen2.5-coder:32b)
LLM_MODEL=
# Для openai: базовый URL, например https://api.openai.com/v1 или http://localhost:11434/v1
LLM_BASE_URL=
# Глубина рассуждений для anthropic: low | medium | high
LLM_EFFORT=low
LLM_TEMPERATURE=0.1
# Максимум раундов repair-loop
MAX_REPAIRS=3
