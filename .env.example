# ============================== Модель (меняется только здесь, без правки кода) ==============================
# LLM_PROVIDER: openai  — любой OpenAI-совместимый API: vLLM, Ollama, LM Studio, OpenRouter, OpenAI
#               yandex  — Yandex AI Studio (Foundation Models)
#               gemini  — Google Gemini;  anthropic — Claude
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# --- Пример: Yandex AI Studio (финал) ---
# LLM_PROVIDER=yandex
# YANDEX_FOLDER_ID=b1g...                 # каталог; модель разворачивается в gpt://<folder>/<model>
# LLM_MODEL=gpt-oss-120b/latest           # или qwen3-235b-a22b-fp8/latest, yandexgpt/latest
# LLM_API_KEY=AQVN...                     # API-ключ сервисного аккаунта (или IAM-токен t1....)

# --- Пример: Qwen3 через vLLM / Ollama ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://gpu-host:8000/v1    # Ollama: http://localhost:11434/v1
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B

# Структурированный вывод: json_schema (по умолчанию) | json_object | prompt_json.
# Если endpoint не поддерживает json_schema, адаптер сам перейдёт на json_object, затем на JSON по промпту.
LLM_JSON_MODE=json_schema
# gpt-oss: глубина рассуждений (low | medium | high), пусто — не передавать
LLM_REASONING_EFFORT=
# Отдельная модель для цикла самоисправления (пусто — та же)
LLM_REPAIR_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=180
# Максимум раундов самоисправления через LLM (после детерминированных исправлений)
MAX_REPAIRS=3
# Закрепить версии промптов: PROMPT_VERSIONS=ir_extract.system=1,ir_edit.system=2
PROMPT_VERSIONS=

# ============================== Защита данных ==============================
# Персональные данные (ФИО, телефоны, e-mail, ИНН/СНИЛС, адреса, номера документов) маскируются перед
# КАЖДЫМ запросом к модели всегда — отключить это настройкой нельзя (backend/app/privacy.py).
LLM_ONPREM_ONLY=false         # true — разрешена только локальная модель (localhost/внутренняя сеть)

# ============================== Пользователи и команды ==============================
# true — без входа API недоступен (регистрация и вход в интерфейсе). Команды и общие проекты
# всегда требуют входа. Пользователи хранятся в data/app.db (SQLite), пароли — только хэш scrypt.
REQUIRE_LOGIN=true

# ============================== Прочее ==============================
# Gemini: резервные модели через запятую (пусто — подбираются автоматически)
LLM_FALLBACK_MODELS=
# Anthropic: глубина рассуждений low | medium | high
LLM_EFFORT=low
# Необязательная смысловая проверка Jev через OpenRouter
JEV_ENABLED=false
JEV_MODEL=typesafe/jev-1.13

# Только для docker compose --profile share: токен аккаунта ngrok.
# Не публикуйте настоящий токен в Git.
NGROK_AUTHTOKEN=
